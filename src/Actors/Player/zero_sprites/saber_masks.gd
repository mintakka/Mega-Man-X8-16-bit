static func rects_for(attack : String, step : int) -> Array:
	var data : Dictionary = DATA.get(attack, {})
	if data.empty() or data.timeline.empty():
		return []
	var timeline_step := step
	if timeline_step >= data.timeline.size():
		if data.loop.size() != 2:
			timeline_step = data.timeline.size() - 1
		else:
			var loop_start : int = data.loop[0]
			var loop_end : int = min(data.loop[1], data.timeline.size() - 1)
			var loop_length : int = max(1, loop_end - loop_start + 1)
			timeline_step = loop_start + ((timeline_step - data.timeline.size()) % loop_length)
	var mask_index : int = data.timeline[max(0, timeline_step)]
	return data.masks[mask_index]
